    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH attempt AS (\n    INSERT INTO ops.refund_actions (\n        order_id,\n        idempotency_key,\n        amount,\n        status\n    )\n    VALUES (\n        $1::TEXT,\n        'refund:' || $1::TEXT,\n        $2::NUMERIC,\n        CASE\n            WHEN $3::BOOLEAN\n            THEN 'pending_approval'\n            ELSE 'approved'\n        END\n    )\n    ON CONFLICT (idempotency_key) DO NOTHING\n    RETURNING *\n)\nSELECT\n    attempt.*,\n    TRUE AS newly_created\nFROM attempt\n\nUNION ALL\n\nSELECT\n    r.*,\n    FALSE AS newly_created\nFROM ops.refund_actions r\nWHERE r.idempotency_key = 'refund:' || $1::TEXT\n  AND NOT EXISTS (SELECT 1 FROM attempt);\n",
