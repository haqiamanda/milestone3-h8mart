    {
      "parameters": {
        "jsCode": "\nconst request = $('Catat Usulan Refund').first().json;\nconst incoming = $input.first().json;\n\nconst response = incoming.data ?? {};\n\nconst allowedOpsId = '1035938312';\n\nconst responderId = String(response.responder?.id ?? '');\nconst responderSource = String(response.responder?.source ?? '');\nconst chatId = String(response.chatId ?? '');\n\nconst validResponder =\n  responderId === allowedOpsId &&\n  chatId === allowedOpsId &&\n  responderSource === 'telegram';\n\nconst validDecision =\n  typeof response.approved === 'boolean';\n\nconst validRequest =\n  validResponder &&\n  validDecision &&\n  request.status === 'pending_approval' &&\n  request.newly_created === true;\n\nconst approved =\n  validRequest &&\n  response.approved === true;\n\nconst decision = !validRequest\n  ? 'invalid'\n  : approved\n    ? 'approve'\n    : 'reject';\n\nreturn [{\n  json: {\n    action_id: request.action_id,\n    order_id: request.order_id,\n    idempotency_key: request.idempotency_key,\n    amount: Number(request.amount),\n    original_status: request.status,\n    decision,\n    approved,\n    valid_request: validRequest,\n    approved_by: validRequest\n      ? `telegram:${responderId}`\n      : null,\n    responded_at: validRequest\n      ? response.respondedAt\n      : null,\n    reason: !validRequest\n      ? 'Keputusan atau identitas approver tidak valid'\n      : approved\n        ? 'Refund disetujui Ops melalui Telegram'\n        : 'Refund ditolak Ops melalui Telegram'\n  }\n}];\n"
      },
