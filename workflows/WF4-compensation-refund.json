        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst event = $('Terima Event Kompensasi').first().json.body;\n\nreturn $input.all().map(item => {\n  const order = item.json;\n\n  const eventType = event.event;\n  const minutesLate = Number(event.minutes_late ?? 0);\n  const totalAmount = Number(order.total_amount ?? 0);\n\n  let action = \"invalid\";\n  let amount = 0;\n  let requiresApproval = false;\n  let reason = \"\";\n\n  if (eventType === \"delivery.late\") {\n    if (Number.isFinite(minutesLate) && minutesLate > 0) {\n      action = \"voucher\";\n      amount = minutesLate <= 15 ? 5000 : 10000;\n      reason = \"Kompensasi keterlambatan pengiriman\";\n    } else {\n      reason = \"Durasi keterlambatan tidak valid\";\n    }\n  } else if (eventType === \"order.failed\") {\n    if (order.payment_status === \"captured\" && totalAmount > 0) {\n      action = \"refund\";\n      amount = totalAmount;\n      requiresApproval = amount > 50000;\n      reason = \"Refund order gagal dengan pembayaran captured\";\n    } else {\n      action = \"no_refund\";\n      reason = \"Pembayaran belum captured atau nominal tidak valid\";\n    }\n  } else {\n    reason = \"Jenis event tidak dikenal\";\n  }\n\n  return {\n    json: {\n      ...order,\n      event_type: eventType,\n      minutes_late: minutesLate,\n      action,\n      amount,\n      requires_approval: requiresApproval,\n      reason\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
