    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH attempt AS (\n    INSERT INTO ops.compensations (\n        order_id,\n        kind,\n        amount,\n        idempotency_key,\n        status\n    )\n    VALUES (\n        $1::TEXT,\n        'voucher',\n        $2::NUMERIC,\n        'voucher:' || $1::TEXT,\n        'pending'\n    )\n    ON CONFLICT (idempotency_key) DO NOTHING\n    RETURNING *\n)\nSELECT\n    attempt.*,\n    TRUE AS newly_created\nFROM attempt\n\nUNION ALL\n\nSELECT\n    c.*,\n    FALSE AS newly_created\nFROM ops.compensations c\nWHERE c.idempotency_key = 'voucher:' || $1::TEXT\n  AND NOT EXISTS (SELECT 1 FROM attempt);\n",
        "options": {
          "queryReplacement": "=\n{{ [\n  $json.order_id,\n  $json.amount\n] }}\n"
