    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT\n    o.order_id,\n    o.merchant_id,\n    o.customer_id,\n    o.status,\n    o.payment_status,\n    o.total_amount,\n    o.order_date\nFROM core.orders AS o\nWHERE o.order_id = $1::TEXT\nLIMIT 1;\n",
        "options": {
          "queryReplacement": "=\n{{ [\n  $('Terima Event Kompensasi').first().json.body.order_id\n] }}\n"
        }
      },
